# ─── Credentials (never commit!) ───
# Option 1: Create a .env file here with real values (it's .gitignored)
# Option 2: Skip this file — the client auto-falls back to ~/Documents/jira-automation/.env
#
JIRA_BASE_URL=https://your-tenant.atlassian.net
JIRA_EMAIL=user@example.com
JIRA_API_TOKEN=your-jira-api-token

XRAY_CLIENT_ID=your-xray-client-id
XRAY_CLIENT_SECRET=your-xray-client-secret
XRAY_BASE_URL=https://xray.cloud.getxray.app/api/v2

# ─── Corporate SSL bypass (set to 0 for example corporate proxy) ───
NODE_TLS_REJECT_UNAUTHORIZED=0
