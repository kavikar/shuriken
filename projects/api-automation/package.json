{
  "name": "api-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-assisted API automation for Swagger/OpenAPI and Postman sources",
  "scripts": {
    "execute:scripts": "tsx src/runners/execute-scripts.ts",
    "framework": "tsx src/runners/framework-cli.ts",
    "generate:scripts": "tsx src/runners/generate-scripts.ts",
    "postman:epsilon-open": "tsx src/runners/run-postman-epsilon-open.ts",
    "postman:epsilon-open:qa": "tsx src/runners/run-postman-epsilon-open.ts --env qa",
    "postman:epsilon-open:uat": "tsx src/runners/run-postman-epsilon-open.ts --env uat",
    "report:epsilon-open": "tsx src/runners/report-newman-epsilon-open.ts",
    "cleanup:epsilon-reports": "tsx src/runners/cleanup-report-archives.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
