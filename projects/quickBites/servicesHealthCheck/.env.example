# servicesHealthCheck environment variables
# The engine also reads these from projects/jira/.env when process env vars are unset.
# Copy to a real .env and replace the placeholder values.

CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki
CONFLUENCE_EMAIL=replace_me
CONFLUENCE_API_TOKEN=replace_me
HEALTH_CONFLUENCE_PARENT_PAGE_ID=replace_me
CONFLUENCE_PARENT_PAGE_ID=replace_me
HEALTH_CHECK_CACHE_TTL_SEC=300
HEALTH_CHECK_STATIC_FALLBACK=1
HEALTH_CHECK_VERIFY_TLS=
NODE_TLS_REJECT_UNAUTHORIZED=
